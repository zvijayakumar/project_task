-- Using self join to arive at the sum of weight for each turn 
select q1.turn , q2.turn ,q1.weight,q2.weight, sum(q2.weight) over(partition by q1.turn order by q1.turn )
from queue q1 join queue q2 on q1.turn >= q2.turn

--Solution 

select person_name from (
select turn, person_name, weight,case when 
 sum(weight) over(order by turn) <= 1000 then 1 else 0 end as roll_sum
from queue
) a where a.roll_sum = 1 order by turn desc limit 1 